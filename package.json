{
  "name": "actions-runner-dashboard",
  "version": "1.1.0",
  "description": "Set up and run several self-hosted GitHub Actions runners on one Windows machine, with a terminal or web dashboard",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=18.14"
  },
  "scripts": {
    "start": "node dashboard/index.mjs",
    "web": "node dashboard/index.mjs --web",
    "site": "node dashboard/site.mjs",
    "site:stop": "node dashboard/site.mjs stop",
    "web:build": "pnpm --dir web build",
    "web:dev": "pnpm --dir web dev",
    "setup-runners": "node setup/index.mjs",
    "status": "bash runners.sh status",
    "watch": "bash runners.sh watch"
  }
}
